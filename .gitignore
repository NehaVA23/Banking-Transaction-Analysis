# Data files — keep large datasets out of GitHub
data/*.csv
data/*.xlsx
data/*.parquet

# Python cache and temporary files
__pycache__/
*.py[cod]
*.log

# Jupyter temporary files
.ipynb_checkpoints/

# Environment variables and credentials
.env
.env.*
!.env.example
secrets.json
credentials.json

# Virtual environments
.venv/
venv/
env/

# System files
.DS_Store
Thumbs.db
desktop.ini

# Temporary and backup files
*.tmp
*.bak
*.old
~$*

# MySQL database exports and dumps
*.sql.gz
*.dump
*.mysql

# Power BI temporary and backup files
*.pbix.autosave
*.pbit
